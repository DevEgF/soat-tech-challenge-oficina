    {
      "name": "Público (cliente)",
      "description": "Endpoints abertos para o cliente final acompanhar e aprovar/reprovar o orçamento da OS sem autenticação.",
      "item": [
        {
          "name": "Acompanhar OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/os/acompanhar?documento={{documentoDigits}}&codigo={{trackingCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "os", "acompanhar"],
              "query": [
                { "key": "documento", "value": "{{documentoDigits}}" },
                { "key": "codigo", "value": "{{trackingCode}}" }
              ]
            }
          }
        },
        {
          "name": "Aprovar orçamento (cliente)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/os/aprovar-orcamento?documento={{documentoDigits}}&codigo={{trackingCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "os", "aprovar-orcamento"],
              "query": [
                { "key": "documento", "value": "{{documentoDigits}}" },
                { "key": "codigo", "value": "{{trackingCode}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status = AWAITING_PARTS_RELEASE', () => pm.expect(pm.response.json().status).to.eql('AWAITING_PARTS_RELEASE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reprovar orçamento (cliente)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/os/reprovar-orcamento?documento={{documentoDigits}}&codigo={{trackingCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "os", "reprovar-orcamento"],
              "query": [
                { "key": "documento", "value": "{{documentoDigits}}" },
                { "key": "codigo", "value": "{{trackingCode}}" }
              ]
            }
          }
        }
      ]
    },
