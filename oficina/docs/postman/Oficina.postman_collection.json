  "item": [
    {
      "name": "Auth",
      "description": "Login para cada papel. O token é gravado automaticamente em variáveis da coleção (`adminToken`, `masterToken`, `attendantToken`, `technicianToken`, `warehouseToken`). O usuário `master` possui todos os scopes (ADMIN/ATTENDANT/TECHNICIAN/WAREHOUSE).",
      "item": [
        {
          "name": "Login master",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{masterUsername}}\",\n  \"password\": \"{{masterPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/public/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "public", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('masterToken', json.accessToken);",
                  "pm.test('accessToken presente', () => pm.expect(json.accessToken).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
