    {
      "name": "Atendente",
      "description": "Endpoints de atendente. Requer Bearer token de SCOPE_ATTENDANT.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{attendantToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Criar OS (com cliente, veículo e linhas)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerTaxId\": \"{{documento}}\",\n  \"customerName\": \"Maria Teste\",\n  \"customerEmail\": \"maria@example.com\",\n  \"customerPhone\": \"+5511999999999\",\n  \"plate\": \"{{placa}}\",\n  \"vehicleBrand\": \"VW\",\n  \"vehicleModel\": \"Gol\",\n  \"vehicleYear\": 2020,\n  \"services\": [\n    { \"catalogServiceId\": \"{{catalogServiceId}}\", \"quantity\": 1 }\n  ],\n  \"parts\": [\n    { \"partId\": \"{{partId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/attendant/ordens-servico", "host": ["{{baseUrl}}"], "path": ["api", "attendant", "ordens-servico"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
