{
  "info": {
    "name": "Oficina - Tech Challenge",
    "description": "Coleção completa para testar a API da Oficina (Spring Boot/Kotlin). Inclui Auth, CRUDs administrativos, fluxo da OS por papel (atendente/técnico/almoxarife) e um cenário 'Fluxo completo (Event Storm)' que executa o swimlane ponta a ponta. Variáveis de ambiente são preenchidas automaticamente pelos scripts de teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminUsername", "value": "admin", "type": "string" },
    { "key": "adminPassword", "value": "admin", "type": "string" },
    { "key": "masterUsername", "value": "master", "type": "string" },
    { "key": "masterPassword", "value": "master", "type": "string" },
    { "key": "attendantUsername", "value": "atendente", "type": "string" },
    { "key": "attendantPassword", "value": "atendente", "type": "string" },
    { "key": "technicianUsername", "value": "tecnico", "type": "string" },
    { "key": "technicianPassword", "value": "tecnico", "type": "string" },
    { "key": "warehouseUsername", "value": "almoxarife", "type": "string" },
    { "key": "warehousePassword", "value": "almoxarife", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "masterToken", "value": "", "type": "string" },
    { "key": "attendantToken", "value": "", "type": "string" },
    { "key": "technicianToken", "value": "", "type": "string" },
